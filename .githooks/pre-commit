#!/usr/bin/env bash
# .githooks/pre-commit — fast checks only (target: <5s)
#
# Runs: link verification, HTML lint, SVG variable check, pytest
# Does NOT run: Playwright interactive tests (those go in pre-push)
#
# Bypass: git commit --no-verify

set -e

# Ensure we're in the project root
cd "$(git rev-parse --show-toplevel)"

# Check mise is available
if ! command -v mise &>/dev/null; then
  echo "⚠ mise not found — skipping pre-commit checks"
  echo "  Install: https://mise.jdx.dev"
  exit 0
fi

echo "▶ pre-commit: running fast checks..."

# Use mise exec to ensure correct Python + venv
mise exec -- python tools/draw-diagram.py --type flow --data '{"nodes":[{"label":"A","color":"blue"},{"label":"B","color":"green"}],"arrows":["test"]}' > /dev/null
mise exec -- python tools/verify-links.py
mise exec -- python tools/lint-html.py
mise exec -- python tools/check-svg-vars.py --workspace examples/oidc-rust --workspace examples/workout-fundamentals --workspace examples/godot-gamedev
mise exec -- python -m pytest tools/test_map_page.py tools/test_map_parser.py -q

echo "✓ pre-commit checks passed"
