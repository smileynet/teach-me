#!/usr/bin/env bash
# .githooks/pre-commit — full verification gate
#
# Runs the complete mise run verify pipeline:
#   links, lint, SVG vars, pytest, Playwright interactive checks
#
# Bypass: git commit --no-verify

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v mise &>/dev/null; then
  echo "⚠ mise not found — skipping pre-commit checks"
  echo "  Install: https://mise.jdx.dev"
  exit 0
fi

echo "▶ pre-commit: running full verification..."

mise run verify

echo "✓ pre-commit checks passed"
