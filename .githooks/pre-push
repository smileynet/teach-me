#!/usr/bin/env bash
# .githooks/pre-push — full verification including Playwright (~10s)
#
# Runs the complete `mise run verify` pipeline (static + interactive).
# Only fires on push — doesn't slow down normal commits.
#
# Bypass: git push --no-verify

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v mise &>/dev/null; then
  echo "⚠ mise not found — skipping pre-push checks"
  exit 0
fi

echo "▶ pre-push: running full verification (static + Playwright)..."

mise run verify

echo "✓ pre-push verification passed"
