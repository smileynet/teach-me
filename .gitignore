# Ephemeral working notes (session-scoped, not committed)
.scratch/

# Reference repos (large, cloned locally for study)
.references/

# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc

# Playwright MCP session data
.playwright-mcp/
*.apkg
/workspace/
# Per-user status/SR overlay (private, disposable — #258/#255). Any depth: the live
# workspace/.user/ AND per-example examples/*/.user/ are all user-local, never committed.
.user/
test-results/
*.png

# mise machine-local config (paths, tool overrides — never committed)
mise.local.toml
**/mise.local.toml
