# Ephemeral working notes (session-scoped, not committed)
.scratch/

# Reference repos (large, cloned locally for study)
.references/

# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc

# Playwright MCP session data
.playwright-mcp/
*.apkg
/workspace/
# Per-user status/SR overlay + private lessons (#258/#255/#184). The `.user/` tree is
# ALWAYS private — status overlay, SR data, and private lessons never ship. The shipped
# library demo progress now lives in committed `library/*/demo-status.json` fixtures
# (#279, Approach B), so `.user/` no longer needs a negation exception.
**/.user/*
test-results/
*.png

# mise machine-local config (paths, tool overrides — never committed)
mise.local.toml
**/mise.local.toml

# Godot editor cache — the only Godot artifact excluded for ink-test-project.
# .uid/.import/addons are COMMITTED per Godot 4.4 guidance (matches test-scene). (#234)
ink-test-project/.godot/

# Orphan compiled-ink scratch with no tracked .ink source — spike/answer-key byproducts
# nobody can regenerate or diff-review. Narrow patterns; do NOT catch lesson .ink.json. (#234)
ink-test-project/stories/test_fallback.*
ink-test-project/stories/exercise_0*_answer.*
